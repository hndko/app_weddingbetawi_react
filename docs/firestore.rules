rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wedding_config/{document=**} {
      allow read, write: if true;
    }
    match /wishes/{document=**} {
      allow read, write: if true;
    }
    match /rsvps/{document=**} {
      allow read, write: if true;
    }
  }
}

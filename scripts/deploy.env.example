# ==============================================================================
# MARI PARTNER - MASTER CLIENT DEPLOYMENT CONFIGURATION
# Salin berkas ini ke `scripts/deploy.env` di server Anda untuk menimpa nilai bawaan.
# ==============================================================================

# Direktori Induk Penyimpanan Seluruh Instance Klien
BASE_DIR="/var/www/weddings"

# Direktori Sumber Master Repository (digunakan untuk copy aset & shared node_modules)
SOURCE_REPO_DIR="/var/www/wedding-base"

# Konfigurasi Nginx
NGINX_AVAILABLE="/etc/nginx/sites-available"
NGINX_ENABLED="/etc/nginx/sites-enabled"

# Konfigurasi Master Database MySQL Server
DEFAULT_DB_HOST="127.0.0.1"
DEFAULT_DB_PORT="3306"
DEFAULT_DB_USER="root"
DEFAULT_DB_PASS=""

# Port Awal Pencarian Port Otomatis (Range 5001..5999)
START_PORT=5001

# User & Group Web Server (Ubuntu: www-data, aaPanel/CentOS: www)
WEB_USER="www-data"
WEB_GROUP="www-data"

# Email untuk Sertifikat SSL Let's Encrypt Certbot
CERTBOT_EMAIL="admin@maripartner.com"

# Mode Berbagi Node Modules (1 = hemat disk pakai symlink, 0 = copy mandiri)
DEFAULT_SHARED_MODULES=1
